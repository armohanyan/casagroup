NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-only: Express origin for Next rewrites/proxies. Must NOT be the public site URL
# (e.g. https://casagroup.am) or nginx will loop → "Request Header Or Cookie Too Large".
# Must match the Express listen port (BACKEND_PORT / PORT).
BACKEND_INTERNAL_URL=http://127.0.0.1:4000
BACKEND_PORT=4000
# Canonical site origin (no trailing slash) — used for canonicals, Open Graph, sitemap.xml, robots.txt
NEXT_PUBLIC_SITE_URL=https://casagroup.am
