# Copy to `.env.local` at the repository root for local overrides.
# `NEXT_PUBLIC_*` variables are inlined for browser code (see `lib/site-config.ts`).

# Canonical site origin (no trailing slash). Used for:
# - Canonical URLs, Open Graph URLs, and JSON-LD
# - `sitemap.xml` and `robots.txt` from `app/sitemap.ts` and `app/robots.ts`
#
# Example for production:
# NEXT_PUBLIC_SITE_URL=https://www.your-domain.com
#
# Until this is set for builds, sitemap/robots default to https://www.example.com — replace before deploying
# or export NEXT_PUBLIC_SITE_URL in your CI environment.
NEXT_PUBLIC_SITE_URL=
