# Copy to `.env` at the repository root for local overrides.
# Only variables prefixed with `VITE_` are exposed to browser code via `import.meta.env`.

# Canonical site origin (no trailing slash). Used for:
# - Canonical URLs, Open Graph URLs, and JSON-LD in the SPA (see `lib/site-config.ts`)
# - `sitemap.xml` and `robots.txt` written into `dist/` after production build (`scripts/write-seo-dist.mjs`)
#
# Example for production:
# VITE_SITE_URL=https://www.your-domain.com
#
# Until this is set for builds, the post-build script defaults to https://www.example.com — replace it
# before deploying, or export VITE_SITE_URL in your CI environment.
VITE_SITE_URL=
