generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Project {
  id                       String      @id @default(cuid())
  title                    String
  slug                     String      @unique
  location                 String
  city                     String
  description              String      @db.Text
  descriptionHy            String?     @db.Text
  longDescription          String      @db.Text
  longDescriptionHy        String?     @db.Text
  images                   Json
  gallery                  Json?
  videoUrl                 String?
  droneVideos              Json?
  startingPrice            Int
  completionDate           String      @default("")
  status                   String
  availableApartmentsCount Int         @default(0)
  totalApartments          Int         @default(0)
  floors                   Int         @default(0)
  amenities                Json
  nearbyPlaces             Json
  paymentOptions           Json
  developer                String
  architect                String?
  managementCompany        String?
  partnerBank              String?
  constructionStart        String?
  exclusiveSalesRights     String?
  lat                      Float
  lng                      Float
  tags                     Json
  featured                 Boolean     @default(false)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  apartments               Apartment[]
  media                    MediaAsset[]
  views                    ProjectView[]

  @@index([city])
  @@index([status])
  @@index([featured])
}

/** One recorded project page view per browser session. */
model ProjectView {
  id        String   @id @default(cuid())
  projectId String
  sessionId String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sessionId])
  @@index([projectId])
  @@index([createdAt])
}

model Apartment {
  id             String   @id @default(cuid())
  projectId      String
  floor          Int
  rooms          Int
  area           Float
  price          Int
  status         String
  viewType       String   @default("")
  floorPlanImage String   @default("")
  planPdfUrl     String?
  description    String?  @db.Text
  gallery        Json
  balcony        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([rooms])
}

model Inquiry {
  id                String   @id @default(cuid())
  fullName          String
  phone             String
  email             String   @default("")
  interestedProject String   @default("")
  message           String   @db.Text
  kind              String?
  status            String   @default("new")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

/** Configurable lead/inquiry status options (admin-editable). */
model LeadStatus {
  id        String   @id @default(cuid())
  value     String   @unique
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([active])
}

model MediaAsset {
  id           String   @id @default(cuid())
  projectId    String?
  originalPath String
  optimizedPath String?
  posterPath   String?
  mimeType     String
  kind         String
  width        Int?
  height       Int?
  sizeBytes    Int
  createdAt    DateTime @default(now())
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
}
