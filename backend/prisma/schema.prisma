generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Project {
  id                       String      @id @default(cuid())
  /** "building" (apartments + floor plates) or "neighborhood" (land plots + house plans). */
  kind                     String      @default("building")
  /**
   * Apartment sales journey entry depth (ignored for neighborhood):
   * master | complex | buildings | floors | plans
   */
  salesMode                String      @default("plans")
  sitePlanImage            String      @default("")
  title                    String
  titleHy                  String?
  titleRu                  String?
  slug                     String      @unique
  location                 String
  locationHy               String?
  locationRu               String?
  city                     String
  cityHy                   String?
  cityRu                   String?
  description              String      @db.Text
  descriptionHy            String?     @db.Text
  descriptionRu            String?     @db.Text
  longDescription          String      @db.Text
  longDescriptionHy        String?     @db.Text
  longDescriptionRu        String?     @db.Text
  images                   Json
  gallery                  Json?
  videoUrl                 String?
  droneVideos              Json?
  startingPrice            Int
  completionDate           String      @default("")
  completionDateHy         String?
  completionDateRu         String?
  status                   String
  availableApartmentsCount Int         @default(0)
  totalApartments          Int         @default(0)
  floors                   Int         @default(0)
  amenities                Json
  nearbyPlaces             Json
  paymentOptions           Json
  developer                String
  architect                String?
  managementCompany        String?
  partnerBank              String?
  constructionStart        String?
  constructionStartHy      String?
  constructionStartRu      String?
  exclusiveSalesRights     String?
  lat                      Float
  lng                      Float
  tags                     Json
  featured                 Boolean     @default(false)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  apartments               Apartment[]
  buildings                Building[]
  landPlots                LandPlot[]
  mapStages                ProjectMapStage[]
  media                    MediaAsset[]
  views                    ProjectView[]

  @@index([city])
  @@index([status])
  @@index([featured])
}

/**
 * Interactive map stage for apartment sales journey (steps 1–3).
 * Roots have parentId null; hotspots target child stages or buildings.
 */
model ProjectMapStage {
  id        String            @id @default(cuid())
  projectId String
  parentId  String?
  label     String
  labelHy   String?
  labelRu   String?
  imageUrl  String            @default("")
  sortOrder Int               @default(0)
  /** Array of { id, label, points, markerX?, markerY?, targetType, targetId }. */
  hotspots  Json
  /** Free-floating text labels on the stage image (% coords). */
  textLabels Json     @default("[]")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    ProjectMapStage?  @relation("MapStageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  ProjectMapStage[] @relation("MapStageTree")

  @@index([projectId])
  @@index([parentId])
}

/** Named building / block or neighborhood within a project (e.g. 4A, or a cottage community). */
model Building {
  id               String         @id @default(cuid())
  projectId        String
  name             String
  sortOrder        Int            @default(0)
  /** "building" (floor plates) or "neighborhood" (houses + land/price/pictures). */
  kind             String         @default("building")
  /** Step-4 exterior render of the building. */
  exteriorImageUrl String         @default("")
  /** Text labels on the building exterior image (% coords). */
  textLabels       Json           @default("[]")
  landArea         Float?
  price            Int?
  images           Json           @default("[]")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apartments       Apartment[]
  floors           BuildingFloor[]

  @@index([projectId])
}

/** Land plot on a neighborhood site / 3D image. */
model LandPlot {
  id        String      @id @default(cuid())
  projectId String
  label     String
  sortOrder Int         @default(0)
  area      Float?
  price     Int?
  status    String      @default("Available")
  /** Polygon points as % of image width/height (0–100). */
  points    Json
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plans     Apartment[]

  @@index([projectId])
}

/** Full-floor plate image with apartment hotspot polygons for interactive selection. */
model BuildingFloor {
  id              String   @id @default(cuid())
  buildingId      String
  label           String
  sortOrder       Int      @default(0)
  imageUrl        String   @default("")
  /** Array of { apartmentId, points: [x,y][] } with x/y as % of image (0–100). */
  hotspots        Json
  /** Free-floating text labels on the floor plan image (% coords). */
  textLabels      Json     @default("[]")
  /** Floor band polygon on the building exterior image (% coords). */
  exteriorHotspot Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  building        Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@index([buildingId])
}

/** One recorded project page view per browser session. */
model ProjectView {
  id        String   @id @default(cuid())
  projectId String
  sessionId String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sessionId])
  @@index([projectId])
  @@index([createdAt])
}

model Apartment {
  id              String    @id @default(cuid())
  projectId       String
  buildingId      String?
  landPlotId      String?
  apartmentNumber String    @default("")
  floor           Int
  rooms           Int
  area            Float
  landArea        Float?
  price           Int
  status          String
  viewType        String    @default("")
  viewTypeHy      String?
  viewTypeRu      String?
  floorPlanImage  String    @default("")
  planPdfUrl      String?
  description     String?   @db.Text
  descriptionHy   String?   @db.Text
  descriptionRu   String?   @db.Text
  gallery         Json
  balcony         Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  building        Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  landPlot        LandPlot? @relation(fields: [landPlotId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([buildingId])
  @@index([landPlotId])
  @@index([status])
  @@index([rooms])
}

model Inquiry {
  id                String   @id @default(cuid())
  fullName          String
  phone             String
  email             String   @default("")
  interestedProject String   @default("")
  message           String   @db.Text
  kind              String?
  status            String   @default("new")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

/** Configurable lead/inquiry status options (admin-editable). */
model LeadStatus {
  id        String   @id @default(cuid())
  value     String   @unique
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([active])
}

/** Homepage hero carousel slides (admin-managed). */
model HeroSlide {
  id        String   @id @default(cuid())
  imageUrl  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model MediaAsset {
  id           String   @id @default(cuid())
  projectId    String?
  originalPath String
  optimizedPath String?
  posterPath   String?
  mimeType     String
  kind         String
  width        Int?
  height       Int?
  sizeBytes    Int
  createdAt    DateTime @default(now())
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
}
